{
    "name": "wernersoderstrom/mockingbird-api-client",
    "description": "This is a client for Mockingbird external API",
    "keywords": [
        "wernersoderstrom",
        "laravel",
        "mockingbird-api-client"
    ],
    "homepage": "https://github.com/wernersoderstrom/mockingbird-api-client",
    "license": "MIT",
    "authors": [
        {
            "name": "Lasse Lehtinen",
            "email": "lasse.lehtinen@wsoy.fi",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/http": "^12.0||^13.0",
        "illuminate/support": "^12.0||^13.0",
        "illuminate/cache": "^12.0||^13.0",
        "league/iso3166": "^4.5",
        "spatie/laravel-data": "^4.23",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^8.8",
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^11.0.0||^10.0.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Wernersoderstrom\\MockingbirdApiClient\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Wernersoderstrom\\MockingbirdApiClient\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint",
        "docs": "@php bin/generate-docs.php"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Wernersoderstrom\\MockingbirdApiClient\\MockingbirdApiClientServiceProvider"
            ],
            "aliases": {
                "MockingbirdApiClient": "Wernersoderstrom\\MockingbirdApiClient\\Facades\\MockingbirdApiClient",
                "MockingbirdEdition": "Wernersoderstrom\\MockingbirdApiClient\\Facades\\Edition"
            }
        }
    },
    "prefer-stable": true
}
